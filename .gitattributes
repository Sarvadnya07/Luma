# Auto detect text files and perform LF normalization on checkin
* text=auto eol=lf

# Explicit text files
*.rs text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.yaml text eol=lf
*.yml text eol=lf
*.md text eol=lf
*.css text eol=lf
*.html text eol=lf
*.svg text eol=lf
*.sh text eol=lf
*.ps1 text eol=crlf

# Binary file types
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.icns binary
*.pdf binary
*.epub binary
*.cbz binary
*.zip binary
*.tar.gz binary
*.wasm binary
*.db binary
*.sqlite binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
