{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": false,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "ignoreDeprecations": "6.0",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./src/*"],
      "@luma/shared-types": ["../../packages/shared-types/src/index.ts"],
      "@luma/design-system": ["../../packages/design-system/src/index.ts"],
      "@luma/ui": ["../../packages/ui/src/index.tsx"],
      "@luma/reader-ui": ["../../packages/reader-ui/src/index.tsx"],
      "@luma/library-ui": ["../../packages/library-ui/src/index.tsx"],
      "@luma/annotation-ui": ["../../packages/annotation-ui/src/index.tsx"]
    }
  },
  "include": ["src"]
}
