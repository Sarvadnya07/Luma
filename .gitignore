# ==============================================================================
# Luma Project - Git Ignore Rules
# ==============================================================================

# ------------------------------------------------------------------------------
# Rust & Cargo
# ------------------------------------------------------------------------------
target/
**/target/
**/*.rs.bk
*.bk
Cargo.lock

# ------------------------------------------------------------------------------
# Node.js, pnpm & Monorepo Packages
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
.pnpm-store/
dist/
**/dist/
dist-ssr/
build/
out/
.turbo/
.parcel-cache/
*.tsbuildinfo
tsconfig.tsbuildinfo

# Logs & Debuggers
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Linting & Formatting Caches
.eslintcache
.stylelintcache
.prettiercache
.vite/

# ------------------------------------------------------------------------------
# Tauri & Desktop App
# ------------------------------------------------------------------------------
**/src-tauri/target/
**/src-tauri/data/
apps/desktop/src-tauri/data/
src-tauri/wix/
src-tauri/WixTools/
.tauri/
*.tauri

# Tauri Updater Keys & Certificates
*.key
*.key.enc
tauri-signing.key

# ------------------------------------------------------------------------------
# Databases, Local Storage & App Data
# ------------------------------------------------------------------------------
*.sqlite
*.sqlite3
*.sqlite-wal
*.sqlite-shm
*.sqlite-journal
*.db
*.db-wal
*.db-shm
*.db-journal
data/
**/data/

# ------------------------------------------------------------------------------
# Test Outputs, Coverage & Reports
# ------------------------------------------------------------------------------
coverage/
**/coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/
blob-report/
playwright/.cache/
tests/temp/
test-data/
scratch/
reports/
reports/*.log

# ------------------------------------------------------------------------------
# Environment Variables & Secrets
# ------------------------------------------------------------------------------
.env
.env.*
!.env.example
*.local
credentials.json
secrets/
*.pem
*.cert
*.crt
*.pfx
*.p12

# ------------------------------------------------------------------------------
# IDEs, Editors & Tooling
# ------------------------------------------------------------------------------
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.idea/
*.iml
*.ipr
*.iws
*.swp
*.swo
*~
.history/
.zed/

# ------------------------------------------------------------------------------
# Operating System Files
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini
$RECYCLE.BIN/

# Linux
.fuse_hidden*
.directory
.Trash-*

# ------------------------------------------------------------------------------
# AI & Agent Working Directories
# ------------------------------------------------------------------------------
.gemini/
.system_generated/
.claude/

# ------------------------------------------------------------------------------
# Temporary, Backup & Patch Files
# ------------------------------------------------------------------------------
*.tmp
*.temp
*.bak
*.orig
*.rej
